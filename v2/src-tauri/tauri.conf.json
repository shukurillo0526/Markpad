{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markpad Native",
  "version": "1.0.1",
  "identifier": "Voha.MarkpadNative",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Markpad Native",
        "width": 1000,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "json", "yaml", "yml", "toml", "xml", "csv", "txt", "log", "ini"],
        "name": "Markpad Native Document"
      }
    ]
  }
}
