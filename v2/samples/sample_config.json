{
  "appName": "Markpad Native",
  "version": "2.0.0",
  "publisher": "Vodiy",
  "theme": "dark",
  "editor": {
    "fontSize": 14,
    "fontFamily": "JetBrains Mono, Consolas, monospace",
    "wordWrap": true,
    "showInvisibles": false,
    "tabSize": 2,
    "lineNumbers": true,
    "foldGutter": true
  },
  "supportedLanguages": [
    "markdown",
    "json",
    "csv",
    "python",
    "javascript",
    "typescript",
    "rust",
    "html",
    "css",
    "sql",
    "xml",
    "yaml",
    "cpp"
  ],
  "features": {
    "multiTab": true,
    "statusBar": true,
    "sessionRestore": true,
    "recentFilesLimit": 15
  }
}
